include "structs.fbs";

namespace flatzz.test;

table Event {
    number:ulong;
    name:string (required);
}

union Payload { Event, Envelope, Text:string, Again:Event }

table UnionPacket {
    current:Payload;
    history:[Payload];
    required_value:Payload (required);
    required_history:[Payload] (required);
    marker:uint;
}

root_type UnionPacket;
